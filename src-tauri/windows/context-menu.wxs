<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(sys.BUILDARCH) = x86 ?>
    <?define PigryContextWin64 = "no" ?>
  <?else ?>
    <?define PigryContextWin64 = "yes" ?>
  <?endif ?>
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="PigryFolderContextMenu" Guid="*" Win64="$(var.PigryContextWin64)">
        <RegistryKey Root="HKMU" Key="Software\Classes\Directory\shell\Pigry" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="Open with Pigry" KeyPath="yes" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLDIR]pigry.exe&quot;,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]pigry.exe&quot; --open-folder &quot;%1\.&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
      <Component Id="PigryBackgroundContextMenu" Guid="*" Win64="$(var.PigryContextWin64)">
        <RegistryKey Root="HKMU" Key="Software\Classes\Directory\Background\shell\Pigry" ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Value="Open with Pigry" KeyPath="yes" />
          <RegistryValue Name="Icon" Type="string" Value="&quot;[INSTALLDIR]pigry.exe&quot;,0" />
          <RegistryKey Key="command">
            <RegistryValue Type="string" Value="&quot;[INSTALLDIR]pigry.exe&quot; --open-folder &quot;%V\.&quot;" />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
    <ComponentGroup Id="PigryContextMenu">
      <ComponentRef Id="PigryFolderContextMenu" />
      <ComponentRef Id="PigryBackgroundContextMenu" />
    </ComponentGroup>
  </Fragment>
</Wix>
