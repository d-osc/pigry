{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pigry",
  "version": "0.3.12",
  "identifier": "com.pigry.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PIGRY",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "remote-bin/": "pigry-server/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/context-menu.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/context-menu.wxs"],
        "componentGroupRefs": ["PigryContextMenu"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/d-osc/pigry/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGMzFGNzBGQkE0MTVCM0YKUldRL1cwRzZEL2N4anptSWVhODF2QXBNQzVRUlhWWjhmQ0JWT2dZTlJ0TUcwbUMwcWxBaE1nS3AK"
    }
  }
}
